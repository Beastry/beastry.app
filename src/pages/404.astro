---
import Base from '../layouts/Base.astro';
---

<Base title="找不到页面" description="这一页不在 beastry.app 上。">
  <section class="page empty">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>这一页不在这里。</h1>
      <p class="lede">链接可能旧了，或者地址写错了。</p>
      <p class="lede en" lang="en">This page is not on the map.</p>
      <div class="hero-actions">
        <a class="button primary" href="/">回首页</a>
        <a class="button ghost" href="/projects">看项目</a>
      </div>
    </div>
  </section>
</Base>
