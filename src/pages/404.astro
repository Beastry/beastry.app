---
import Base from '../layouts/Base.astro';
---

<Base
  title="找不到页面"
  titleEn="Page not found"
  description="这一页不在 beastry.app 上。"
  descriptionEn="This page is not on beastry.app."
>
  <section class="page empty">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1><span lang="zh-Hans">这一页不在这里。</span><span lang="en">This page is not here.</span></h1>
      <p class="lede" lang="zh-Hans">链接可能旧了，或者地址写错了。</p>
      <p class="lede en" lang="en">The link may be old, or the address may be mistyped.</p>
      <div class="hero-actions">
        <a class="button primary" href="/"><span lang="zh-Hans">回首页</span><span lang="en">Home</span></a>
        <a class="button ghost" href="/projects"><span lang="zh-Hans">看项目</span><span lang="en">Projects</span></a>
      </div>
    </div>
  </section>
</Base>
