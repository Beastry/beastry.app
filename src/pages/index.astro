---
import Base from '../layouts/Base.astro';
import ProductStage from '../components/ProductStage.astro';
import { site } from '../data/site';

const description = 'Beastry 的开源 macOS 应用。Stow、MijiaBar、Octoshot 正在公测，现在可以下载。';
const descriptionEn =
  'Open-source Mac apps from Beastry. Stow, MijiaBar, and Octoshot are in public beta and ready to download.';
---

<Base description={description} descriptionEn={descriptionEn}>
  <section class="welcome">
    <div class="wrap">
      <div class="welcome-card">
        <div class="welcome-copy">
          <p class="kicker">
            <span lang="zh-Hans">开源软件社区</span>
            <span lang="en">Open-source software community</span>
          </p>
          <h1>
            <span lang="zh-Hans">先用起来，<br />也欢迎留下来。</span>
            <span lang="en">Use them now.<br />Stay if you like.</span>
          </h1>
          <p class="lede">
            <span lang="zh-Hans">三款 macOS 应用正在公测，现在可以下载。<span class="keep">想一起做</span>，也有入口。</span>
            <span lang="en">Three Mac apps are in public beta and ready to download. If you want to help build what comes next, there is a way in.</span>
          </p>
          <div class="welcome-actions">
            <a class="button primary" href="#downloads">
              <span lang="zh-Hans">看看作品</span>
              <span lang="en">See the apps</span>
            </a>
            <a class="text-link" href="/community">
              <span lang="zh-Hans">参与一下</span>
              <span lang="en">Join in</span>
              <span aria-hidden="true"> ›</span>
            </a>
          </div>
        </div>
        <img
          class="welcome-mark"
          src="/brand/mark.jpg"
          width="640"
          height="640"
          alt="Beastry 母品牌：打开的书，书上是粉兔、蓝猫和黄熊"
          data-alt-zh="Beastry 母品牌：打开的书，书上是粉兔、蓝猫和黄熊"
          data-alt-en="Beastry mother brand: an open book with a pink rabbit, a blue cat, and a yellow bear"
        />
      </div>
    </div>
  </section>

  <ProductStage />

  <section class="invite" aria-labelledby="invite-title">
    <div class="wrap">
      <div class="invite-card">
        <h2 id="invite-title">
          <span lang="zh-Hans">想一起做</span>
          <span lang="en">Want to help make something?</span>
        </h2>
        <p>
          <span lang="zh-Hans">可以提一个新产品的想法，也可以帮现有作品做一点事。人和 agent 都能来。合并和发布仍由人决定。</span>
          <span lang="en">Suggest a new product, or help one that already exists. People and agents are both welcome. A person still merges and publishes.</span>
        </p>
        <p class="invite-note">
          <span lang="zh-Hans">不用在本站注册账号。</span>
          <span lang="en">No account on this site.</span>
        </p>
        <div class="invite-actions">
          <a class="text-link" href={site.ideaIssue} rel="noreferrer">
            <span lang="zh-Hans">提交想法</span>
            <span lang="en">Submit an idea</span>
            <span aria-hidden="true"> ›</span>
          </a>
          <a class="text-link" href="/community">
            <span lang="zh-Hans">参与贡献</span>
            <span lang="en">Contribute</span>
            <span aria-hidden="true"> ›</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
