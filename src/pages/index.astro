---
import Base from '../layouts/Base.astro';
import ProductStage from '../components/ProductStage.astro';
import { site } from '../data/site';

const description = 'Beastry 是开源软件社区。工具现在就可以下载，也欢迎一起参与。';
const descriptionEn =
  'Beastry is an open-source software community. The tools are ready to download, and you are welcome to take part.';
---

<Base description={description} descriptionEn={descriptionEn}>
  <section class="welcome">
    <div class="wrap">
      <div class="welcome-card">
        <div class="welcome-copy">
          <p class="kicker">
            <span lang="zh-Hans">开源软件社区</span>
            <span lang="en">Open-source software community</span>
          </p>
          <h1>
            <span lang="zh-Hans">先用起来，<br />也欢迎留下来。</span>
            <span lang="en">Use them now,<br />and you are welcome to stay.</span>
          </h1>
          <p class="lede">
            <span lang="zh-Hans">Beastry 是开源软件社区。工具现在就可以下载，也欢迎一起参与。</span>
            <span lang="en">Beastry is an open-source software community. The tools are ready to download, and you are welcome to take part.</span>
          </p>
          <div class="welcome-actions">
            <a class="button primary" href="#downloads">
              <span lang="zh-Hans">看看作品</span>
              <span lang="en">See the work</span>
            </a>
            <a class="text-link" href="/community">
              <span lang="zh-Hans">参与一下</span>
              <span lang="en">Take part</span>
              <span aria-hidden="true"> ›</span>
            </a>
          </div>
        </div>
        <img
          class="welcome-mark"
          src="/brand/mark.jpg"
          width="640"
          height="640"
          alt="Beastry 母品牌：打开的书，书上是粉兔、蓝猫和黄熊"
          data-alt-zh="Beastry 母品牌：打开的书，书上是粉兔、蓝猫和黄熊"
          data-alt-en="Beastry mother brand: an open book with a pink rabbit, a blue cat, and a yellow bear"
        />
      </div>
    </div>
  </section>

  <ProductStage />

  <section class="invite" aria-labelledby="invite-title">
    <div class="wrap">
      <div class="invite-card">
        <h2 id="invite-title">
          <span lang="zh-Hans">想一起做</span>
          <span lang="en">Want to make something?</span>
        </h2>
        <p>
          <span lang="zh-Hans">留下一个想法，或为已有作品做一点贡献。人或 agent 都可以来，合并与发布仍由人来把关。</span>
          <span lang="en">Leave an idea, or help a product that already exists. People and agents are welcome. A person still merges and publishes.</span>
        </p>
        <p class="invite-note">
          <span lang="zh-Hans">不用在本站注册账号。</span>
          <span lang="en">No account on this site.</span>
        </p>
        <div class="invite-actions">
          <a class="text-link" href={site.ideaIssue} rel="noreferrer">
            <span lang="zh-Hans">提交想法</span>
            <span lang="en">Submit an idea</span>
            <span aria-hidden="true"> ›</span>
          </a>
          <a class="text-link" href="/community">
            <span lang="zh-Hans">参与贡献</span>
            <span lang="en">Contribute</span>
            <span aria-hidden="true"> ›</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
