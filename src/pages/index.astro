---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import ContactList from '../components/ContactList.astro';
import { products, site } from '../data/site';

const description =
  'Beastry 是开源软件社区。动物意象的产品线：Octoshot、MijiaBar、记忆面包、AgentKey、Splatty、LetterBee 与 Stow。';
---

<Base description={description}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">Beastry · 开源软件社区 <span lang="en">· Open source</span></p>
        <h1>开源软件社区，<br />温暖一点。</h1>
        <p class="lede">
          我们做开源软件。产品带着动物意象，粉彩卡片和认真写的代码，都希望让人觉得亲近。
        </p>
        <p class="lede en" lang="en">
          An open-source community with a softer edge — one creature for each project, and care for the people who build it.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#work">看项目</a>
          <a class="button ghost" href={site.github} rel="noreferrer">GitHub 组织</a>
        </div>
      </div>
      <figure class="hero-visual">
        <img
          src="/brand/logo-lockup.jpg"
          width="1024"
          height="1024"
          alt="Beastry 字标与珊瑚小标记"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
    <div class="wrap mascot-band">
      <img
        src="/brand/mascots-row.jpg"
        width="1536"
        height="640"
        alt="Beastry 产品吉祥物横排示意"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <h2 class="section-title" id="work-title">作品 · Projects</h2>
      <ul class="product-grid">
        {products.map((product, index) => <ProductCard product={product} index={index} />)}
      </ul>
      <p class="footnote">
        上方吉祥物与卡片色是品牌 v1 示意；正式标志以各仓库为准。
        <span lang="en">Mascots and pastel tiles are brand v1 stand-ins until each project ships its own mark.</span>
      </p>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <h2 class="section-title" id="contact-title">联系 · Contact</h2>
      <ContactList />
    </div>
  </section>
</Base>
