---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import ContactList from '../components/ContactList.astro';
import DownloadList from '../components/DownloadList.astro';
import { productsByStatus, site, statusMeta } from '../data/site';

const beta = productsByStatus('beta');
const developing = productsByStatus('developing');
const onhold = productsByStatus('onhold');

const description =
  'Beastry 是开源软件社区。公测：Stow、MijiaBar、Octoshot；另有开发中与搁置项目。想法收集见 Beastry/ideas。';
const descriptionEn =
  'Beastry is an open-source software community. Public beta: Stow, MijiaBar, and Octoshot. Other projects are in development or on hold. Ideas are collected in Beastry/ideas.';
---

<Base description={description} descriptionEn={descriptionEn}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker"><span lang="zh-Hans">Beastry · 开源软件社区</span> <span lang="en">Beastry · Open source</span></p>
        <h1>
          <span lang="zh-Hans">开源软件社区，<br />温暖一点。</span>
          <span lang="en">Open source,<br />a little warmer.</span>
        </h1>
        <p class="lede" lang="zh-Hans">
          我们做开源软件，也一起想下一只会是什么。母品牌是书与粉兔、蓝猫、黄熊；有官网的产品用它们自己的标志。
        </p>
        <p class="lede en" lang="en">
          An open-source community. The mother brand is a book with a pink rabbit, a blue cat, and a yellow bear. Products with a site use their own marks.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#work"><span lang="zh-Hans">看项目</span><span lang="en">Projects</span></a>
          <a class="button ghost" href="/help"><span lang="zh-Hans">帮助与反馈</span><span lang="en">Help</span></a>
          <a class="button ghost" href="/community"><span lang="zh-Hans">一起做</span><span lang="en">Make</span></a>
          <a class="button ghost" href={site.github} rel="noreferrer"><span lang="zh-Hans">GitHub 组织</span><span lang="en">GitHub</span></a>
        </div>
      </div>
      <figure class="hero-visual">
        <img
          src="/brand/logo-lockup.jpg"
          width="1024"
          height="1024"
          alt="Beastry 母品牌：字标与打开的书，书上是粉兔、蓝猫和黄熊"
          data-alt-zh="Beastry 母品牌：字标与打开的书，书上是粉兔、蓝猫和黄熊"
          data-alt-en="Beastry mother brand: wordmark and an open book with a pink rabbit, a blue cat, and a yellow bear"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <h2 class="section-title" id="work-title"><span lang="zh-Hans">作品</span><span lang="en">Projects</span></h2>

      <div class="status-block" id="beta">
        <h3 class="status-heading">
          <span lang="zh-Hans">{statusMeta.beta.zh}</span>
          <span lang="en">{statusMeta.beta.en}</span>
        </h3>
        <p class="status-lede">
          <span lang="zh-Hans">已可试用的三款；各自有独立介绍页。标志来自它们自己的官网。</span>
          <span lang="en">Three you can try. Each has its own page, and the mark is from that product’s site.</span>
        </p>
        <ul class="product-grid">
          {beta.map((product, index) => <ProductCard product={product} index={index} />)}
        </ul>
      </div>

      <div class="status-block" id="developing">
        <h3 class="status-heading">
          <span lang="zh-Hans">{statusMeta.developing.zh}</span>
          <span lang="en">{statusMeta.developing.en}</span>
        </h3>
        <p class="status-lede">
          <span lang="zh-Hans">还在长的项目。仓库里没有核对到正式标志或安装包，这里不另画、也不提供下载。</span>
          <span lang="en">Still growing. No official mark or installer was verified, so none is invented here.</span>
        </p>
        <ul class="product-grid">
          {developing.map((product, index) => (
            <ProductCard product={product} index={beta.length + index} />
          ))}
        </ul>
      </div>

      <details class="status-block onhold-block" id="onhold">
        <summary class="status-heading">
          <span lang="zh-Hans">{statusMeta.onhold.zh}</span>
          <span lang="en">{statusMeta.onhold.en}</span>
          <span class="summary-hint"><span lang="zh-Hans">展开</span><span lang="en">Show</span></span>
        </summary>
        <p class="status-lede">
          <span lang="zh-Hans">暂时搁置，代码仍在 GitHub。记忆面包的 README 还没有写“已搁置”。</span>
          <span lang="en">Paused for now. The code stays on GitHub. 记忆面包’s README does not itself say it is on hold.</span>
        </p>
        <ul class="product-grid">
          {onhold.map((product, index) => (
            <ProductCard product={product} index={beta.length + developing.length + index} />
          ))}
        </ul>
      </details>

      <DownloadList products={beta} />
      <p class="footnote ideas-cta">
        <span lang="zh-Hans">
          下一只会是什么？到
          <a href={site.ideaIssue} rel="noreferrer">Beastry/ideas</a>
          提交想法（剪贴板、PDF 等构思已在那里）。已有产品的 Bug 和建议在
          <a href="/help">帮助</a>。
        </span>
        <span lang="en">
          Propose a new idea at Beastry/ideas. Bugs and suggestions for a product that already exists go to <a href="/help">Help</a>.
        </span>
      </p>
      <p class="footnote">
        <span lang="zh-Hans">上方字标与书是母品牌（粉兔、蓝猫、黄熊）。它不是产品标志。没有核实到标志的项目留空。</span>
        <span lang="en">The wordmark and book above are the mother brand: a pink rabbit, a blue cat, and a yellow bear. They are not product marks. Products without a verified mark are left blank.</span>
      </p>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <h2 class="section-title" id="contact-title"><span lang="zh-Hans">联系</span><span lang="en">Contact</span></h2>
      <ContactList />
    </div>
  </section>
</Base>
