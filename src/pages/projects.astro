---
import Base from '../layouts/Base.astro';
import DownloadList from '../components/DownloadList.astro';
import { products, statusMeta } from '../data/site';

const description = 'Beastry 的作品：三款公测可以下载，其余还在开发或先搁着。';
const descriptionEn =
  'Works from Beastry. Three public betas can be downloaded. The others are still in development, or paused.';
---

<Base title="作品" titleEn="Works" description={description} descriptionEn={descriptionEn}>
  <article class="page">
    <div class="wrap">
      <p class="kicker"><span lang="zh-Hans">作品</span><span lang="en">Works</span></p>
      <h1><span lang="zh-Hans">作品</span><span lang="en">Works</span></h1>
      <p class="lede" lang="zh-Hans">
        公测的三款现在可以下载。其余还在做，或先搁着，没有安装包。版本和系统要求写在这一页下面。新想法去
        <a href="/community">参与</a>，问题去 <a href="/help">帮助</a>。
      </p>
      <p class="lede en" lang="en">
        The three public betas can be downloaded now. The others are still being built, or are paused, and have no installer. Versions and system requirements are below. New ideas go to
        <a href="/community">Take part</a>. Problems go to <a href="/help">Help</a>.
      </p>

      <ol class="project-list">
        {
          products.map((product) => {
            const status = statusMeta[product.status];
            const external = product.href.startsWith('http');
            return (
              <li class="project" id={product.slug} style={`--wash: ${product.wash}; --wash-dark: ${product.washDark};`}>
                {product.logo && (
                  <img
                    class="logo-mark"
                    src={product.logo.src}
                    width="72"
                    height="72"
                    alt={product.logo.altZh}
                    data-alt-zh={product.logo.altZh}
                    data-alt-en={product.logo.altEn}
                  />
                )}
                <div class="project-main">
                  <p class={`status status-${product.status}`}>
                    <span lang="zh-Hans">{status.zh}</span>
                    <span lang="en">{status.en}</span>
                  </p>
                  <h2>
                    <a href={product.href} rel={external ? 'noreferrer' : undefined}>
                      {product.name}
                    </a>
                    {product.aka && <span class="aka">{product.aka}</span>}
                    <span class="project-platform">{product.platform}</span>
                  </h2>
                  <p>
                    <span lang="zh-Hans">{product.summaryZh}</span>
                    <span lang="en">{product.summaryEn}</span>
                  </p>
                  <p class="detail">
                    <span lang="zh-Hans">{product.detailZh}</span>
                    <span lang="en">{product.detailEn}</span>
                  </p>
                  {product.noteZh && (
                    <p class="note">
                      <span lang="zh-Hans">{product.noteZh}</span>
                      <span lang="en">{product.noteEn}</span>
                    </p>
                  )}
                  {!product.logo && (
                    <p class="note">
                      <span lang="zh-Hans">还没有核实到正式标志，所以这里不放替代图。</span>
                      <span lang="en">No official mark was verified, so no stand-in is shown.</span>
                    </p>
                  )}
                  {product.shot && (
                    <figure class="shot">
                      <img
                        src={product.shot.src}
                        width={product.shot.width}
                        height={product.shot.height}
                        alt={product.shot.altZh}
                        data-alt-zh={product.shot.altZh}
                        data-alt-en={product.shot.altEn}
                        loading="lazy"
                        decoding="async"
                      />
                      <figcaption>
                        <span lang="zh-Hans">{product.shot.altZh}</span>
                        <span lang="en">{product.shot.altEn}</span>
                        {product.shot.noteZh && (
                          <>
                            <span lang="zh-Hans"> {product.shot.noteZh}</span>
                            <span lang="en"> {product.shot.noteEn}</span>
                          </>
                        )}
                      </figcaption>
                    </figure>
                  )}
                  <p class="project-links">
                    <a href={product.github} rel="noreferrer">GitHub</a>
                    {!external && (
                      <>
                        {' · '}
                        <a href={product.href}><span lang="zh-Hans">介绍页</span><span lang="en">Product page</span></a>
                      </>
                    )}
                    {' · '}
                    <a href={product.bugUrl} rel="noreferrer"><span lang="zh-Hans">报告 Bug</span><span lang="en">Report a bug</span></a>
                    {' · '}
                    <a href={product.suggestUrl} rel="noreferrer"><span lang="zh-Hans">提建议</span><span lang="en">Suggest</span></a>
                    {product.extraLinks?.map((link) => (
                      <>
                        {' · '}
                        <a href={link.href} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>
                          <span lang="zh-Hans">{link.zh}</span>
                          <span lang="en">{link.en}</span>
                        </a>
                      </>
                    ))}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ol>

      <DownloadList products={products} />
    </div>
  </article>
</Base>
