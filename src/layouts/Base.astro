---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/outfit';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  titleEn?: string;
  description: string;
  descriptionEn?: string;
}

const { title, titleEn, description, descriptionEn = description } = Astro.props;
const fullTitle = title ? `${title} — Beastry` : 'Beastry — 开源软件社区';
const fullTitleEn = titleEn ? `${titleEn} — Beastry` : 'Beastry — Open-source community';
const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Beastry',
  url: site.url,
  email: 'hello@beastry.app',
  description: '开源软件社区。Open-source software community.',
  sameAs: [site.github, site.x.href],
};
---

<!doctype html>
<html
  lang="zh-Hans"
  data-lang="zh"
  data-title-zh={fullTitle}
  data-title-en={fullTitleEn}
  data-desc-zh={description}
  data-desc-en={descriptionEn}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
        }
        let lang = localStorage.getItem('beastry-lang');
        if (lang === 'both') {
          lang = 'zh';
          localStorage.setItem('beastry-lang', 'zh');
        }
        if (lang !== 'en') lang = 'zh';
        const root = document.documentElement;
        root.dataset.lang = lang;
        root.lang = lang === 'en' ? 'en' : 'zh-Hans';
      } catch (error) {
        document.documentElement.dataset.lang = 'zh';
        document.documentElement.lang = 'zh-Hans';
      }
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/mark.jpg" type="image/jpeg" sizes="any" />
    <meta name="theme-color" content="#fff6ee" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@beastryapp" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      const root = document.documentElement;
      const english = root.dataset.lang === 'en';
      const titleText = english ? root.dataset.titleEn : root.dataset.titleZh;
      const descText = english ? root.dataset.descEn : root.dataset.descZh;
      if (titleText) document.title = titleText;
      const writeMeta = (selector, value) => {
        if (!value) return;
        document.querySelectorAll(selector).forEach((node) => node.setAttribute('content', value));
      };
      writeMeta('meta[name="description"]', descText);
      writeMeta('meta[property="og:description"]', descText);
      writeMeta('meta[name="twitter:description"]', descText);
      writeMeta('meta[property="og:title"]', titleText);
      writeMeta('meta[name="twitter:title"]', titleText);
      writeMeta('meta[property="og:locale"]', english ? 'en_US' : 'zh_CN');
    </script>
  </head>
  <body>
    <a class="skip" href="#main"><span lang="zh-Hans">跳到正文</span><span lang="en">Skip to content</span></a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      type Pattern = 'stow' | 'mijiabar' | 'octoshot';

      function matchedRelease(release: any, pattern: Pattern): { url: string; tag: string; published: string } | null {
        const tag = release?.tag_name;
        if (typeof tag !== 'string' || !/^v\d+\.\d+\.\d+$/.test(tag)) return null;
        const assets = Array.isArray(release.assets) ? release.assets : [];
        const uploaded = (name: string, url: string) =>
          assets.some(
            (asset: any) =>
              asset &&
              asset.name === name &&
              asset.state === 'uploaded' &&
              asset.browser_download_url === url,
          );

        if (pattern === 'stow') {
          const filename = `Stow-${tag.slice(1)}.dmg`;
          const url = `https://github.com/Beastry/stow/releases/download/${tag}/${filename}`;
          return uploaded(filename, url) ? { url, tag, published: String(release.published_at || '') } : null;
        }
        if (pattern === 'mijiabar') {
          const filename = `MijiaBar-${tag.slice(1)}.dmg`;
          const url = `https://github.com/Beastry/MijiaBar/releases/download/${tag}/${filename}`;
          return uploaded(filename, url) ? { url, tag, published: String(release.published_at || '') } : null;
        }
        const prefix = `https://github.com/Beastry/Octoshot/releases/download/${tag}/`;
        const asset = assets.find(
          (item: any) =>
            item &&
            item.state === 'uploaded' &&
            typeof item.name === 'string' &&
            /\.dmg$/i.test(item.name) &&
            item.browser_download_url === prefix + item.name,
        );
        return asset ? { url: asset.browser_download_url, tag, published: String(release.published_at || '') } : null;
      }

      const groups = new Map<string, HTMLElement[]>();
      document.querySelectorAll<HTMLElement>('[data-release]').forEach((node) => {
        const repo = node.dataset.repo;
        const pattern = node.dataset.pattern;
        if (!repo || (pattern !== 'stow' && pattern !== 'mijiabar' && pattern !== 'octoshot')) return;
        const key = `${repo}|${pattern}`;
        const list = groups.get(key) ?? [];
        list.push(node);
        groups.set(key, list);
      });

      groups.forEach((nodes, key) => {
        const [repo, pattern] = key.split('|') as [string, Pattern];
        fetch(`https://api.github.com/repos/${repo}/releases/latest`, {
          headers: { Accept: 'application/vnd.github+json' },
        })
          .then((response) => (response.ok ? response.json() : null))
          .then((release) => {
            const next = matchedRelease(release, pattern);
            if (!next) return;
            const day = /^\d{4}-\d{2}-\d{2}/.test(next.published) ? next.published.slice(0, 10) : '';
            nodes.forEach((node) => {
              if (node instanceof HTMLAnchorElement) node.href = next.url;
              if (node.dataset.releaseVersion !== undefined) node.textContent = next.tag;
              if (node.dataset.releaseDate !== undefined && day) {
                node.textContent = day;
                node.setAttribute('datetime', day);
              }
            });
          })
          .catch(() => {
            /* The pinned file stays available. */
          });
      });
    </script>
  </body>
</html>
