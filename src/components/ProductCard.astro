---
import Mark from './Mark.astro';
import { indexLabel, statusMeta, type Product } from '../data/site';

interface Props {
  product: Product;
  index: number;
}

const { product, index } = Astro.props;
const status = statusMeta[product.status];
const external = product.href.startsWith('http');
---

<li>
  <a
    class="card"
    href={product.href}
    style={`--wash: ${product.wash}; --wash-dark: ${product.washDark};`}
    rel={external ? 'noreferrer' : undefined}
  >
    <div class="card-top">
      <span class="mark">
        <Mark name={product.mark} label={product.markLabel} />
      </span>
      <span class="index">{indexLabel(index)}</span>
    </div>
    <div class="card-badges">
      <span class={`status status-${product.status}`}>{status.zh}<span class="en" lang="en"> · {status.en}</span></span>
    </div>
    <h3>
      {product.name}
      {product.aka && <span class="aka">{product.aka}</span>}
    </h3>
    <p class="summary">{product.summaryZh}</p>
    <p class="summary en" lang="en">{product.summaryEn}</p>
    {
      product.noteZh && (
        <p class="note">
          {product.noteZh}
          <span class="en" lang="en">
            {product.noteEn}
          </span>
        </p>
      )
    }
    <p class="card-meta">
      <span>{product.platform}</span>
      <span class="go">{external ? 'GitHub' : '站点'} <span aria-hidden="true">↗</span></span>
    </p>
  </a>
</li>
