---
import { indexLabel, statusMeta, type Product } from '../data/site';

interface Props {
  product: Product;
  index: number;
}

const { product, index } = Astro.props;
const status = statusMeta[product.status];
const external = product.href.startsWith('http');
---

<li>
  <a
    class="card"
    href={product.href}
    style={`--wash: ${product.wash}; --wash-dark: ${product.washDark};`}
    rel={external ? 'noreferrer' : undefined}
  >
    <div class="card-top">
      {
        product.logo && (
          <img
            class="logo-mark"
            src={product.logo.src}
            width="68"
            height="68"
            alt={product.logo.altZh}
            data-alt-zh={product.logo.altZh}
            data-alt-en={product.logo.altEn}
          />
        )
      }
      <span class="index">{indexLabel(index)}</span>
    </div>
    <div class="card-badges">
      <span class={`status status-${product.status}`}>
        <span lang="zh-Hans">{status.zh}</span>
        <span lang="en">{status.en}</span>
      </span>
    </div>
    <h3>
      {product.name}
      {product.aka && <span class="aka">{product.aka}</span>}
    </h3>
    <p class="summary">
      <span lang="zh-Hans">{product.summaryZh}</span>
      <span lang="en">{product.summaryEn}</span>
    </p>
    {
      product.noteZh && (
        <p class="note">
          <span lang="zh-Hans">{product.noteZh}</span>
          <span lang="en">{product.noteEn}</span>
        </p>
      )
    }
    {
      !product.logo && (
        <p class="note">
          <span lang="zh-Hans">还没有核实到正式标志。</span>
          <span lang="en">No official mark verified yet.</span>
        </p>
      )
    }
    <p class="card-meta">
      <span>{product.platform}</span>
      <span class="go">
        <span lang="zh-Hans">{external ? 'GitHub' : '站点'}</span>
        <span lang="en">{external ? 'GitHub' : 'Site'}</span>
        <span aria-hidden="true"> ↗</span>
      </span>
    </p>
  </a>
</li>
