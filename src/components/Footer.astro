---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="wrap footer-inner">
    <div>
      <p class="footer-name">Beastry</p>
      <p class="muted"><span lang="zh-Hans">开源软件社区</span> <span lang="en">Open-source software community</span></p>
    </div>
    <ul class="footer-links">
      <li>
        <a href="/projects"><span lang="zh-Hans">作品</span><span lang="en">Works</span></a>
      </li>
      <li>
        <a href="/help"><span lang="zh-Hans">帮助</span><span lang="en">Help</span></a>
      </li>
      <li>
        <a href="/community"><span lang="zh-Hans">参与</span><span lang="en">Take part</span></a>
      </li>
      <li>
        <a href="/about"><span lang="zh-Hans">关于</span><span lang="en">About</span></a>
      </li>
      <li>
        <a href="/agents"><span lang="zh-Hans">Agent 说明</span><span lang="en">For agents</span></a>
      </li>
      {
        site.emails.map((email) => (
          <li>
            <a href={`mailto:${email.address}`}>{email.address}</a>
          </li>
        ))
      }
      <li>
        <a href={site.x.href} rel="noreferrer">X {site.x.handle}</a>
      </li>
      <li>
        <a href={site.github} rel="noreferrer">GitHub</a>
      </li>
    </ul>
    <p class="legal">
      <span lang="zh-Hans">
        © {year} Beastry. 本站第一方内容以
        <a href="https://www.gnu.org/licenses/gpl-3.0.html" rel="noreferrer">GPL-3.0-only</a>
        授权（仅第 3 版）。产品镜像页仍按其上游许可证提供。
      </span>
      <span lang="en">
        © {year} Beastry. First-party material on this site is
        <a href="https://www.gnu.org/licenses/gpl-3.0.html" rel="noreferrer">GPL-3.0-only</a>
        (version 3 only). Imported product pages keep their upstream licenses.
      </span>
    </p>
  </div>
</footer>
