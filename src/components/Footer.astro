---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <p class="footer-name">Beastry</p>
      <p class="muted"><span lang="zh-Hans">开源软件社区</span> <span lang="en">Open-source software community</span></p>
    </div>
    <ul class="footer-links">
      <li>
        <a href="/projects"><span lang="zh-Hans">项目</span><span lang="en">Projects</span></a>
      </li>
      <li>
        <a href="/help"><span lang="zh-Hans">帮助</span><span lang="en">Help</span></a>
      </li>
      <li>
        <a href="/community"><span lang="zh-Hans">社区</span><span lang="en">Community</span></a>
      </li>
      <li>
        <a href="/about"><span lang="zh-Hans">关于</span><span lang="en">About</span></a>
      </li>
      {
        site.emails.map((email) => (
          <li>
            <a href={`mailto:${email.address}`}>{email.address}</a>
          </li>
        ))
      }
      <li>
        <a href={site.x.href} rel="noreferrer">X {site.x.handle}</a>
      </li>
      <li>
        <a href={site.github} rel="noreferrer">GitHub</a>
      </li>
    </ul>
    <p class="legal">
      © {year} Beastry. 本站第一方内容以
      <a href="https://www.gnu.org/licenses/gpl-3.0.html" rel="noreferrer">GPL-3.0-only</a>
      授权（仅第 3 版）。产品镜像页仍按其上游许可证提供。
    </p>
  </div>
</footer>
