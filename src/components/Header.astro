---
import { navLinks, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function current(href: string): 'page' | undefined {
  return href === path ? 'page' : undefined;
}
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="/" aria-label="Beastry 首页">
      <img class="brand-mark" src="/brand/mark.jpg" width="64" height="64" alt="" />
      <span>Beastry</span>
    </a>
    <div class="header-tools">
      <nav class="nav nav-desktop" aria-label="主导航">
        {
          navLinks.map((link) => (
            <a href={link.href} aria-current={current(link.href)}>
              <span lang="zh-Hans">{link.zh}</span>
              <span lang="en">{link.en}</span>
            </a>
          ))
        }
        <a href={site.github} rel="noreferrer">GitHub</a>
      </nav>
      <div class="lang-switch" role="group" aria-label="语言">
        <button type="button" data-lang-set="zh" aria-pressed="false">中文</button>
        <button type="button" data-lang-set="en" aria-pressed="false">EN</button>
        <button type="button" data-lang-set="both" aria-pressed="true">中英</button>
      </div>
      <button type="button" class="theme-btn" id="theme-toggle" aria-label="切换深色或浅色">
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M15.5 3.5a8.2 8.2 0 1 0 5 12.2A7.2 7.2 0 0 1 15.5 3.5z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3.4" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
          <path
            d="M12 3.5v2.2M12 18.3v2.2M3.5 12h2.2M18.3 12h2.2M6 6l1.6 1.6M16.4 16.4 18 18M18 6l-1.6 1.6M7.6 16.4 6 18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"></path>
        </svg>
      </button>
      <details class="nav-fold">
        <summary class="nav-toggle">
          <span lang="zh-Hans">菜单</span>
          <span lang="en">Menu</span>
        </summary>
        <nav class="nav nav-panel" aria-label="主导航">
          {
            navLinks.map((link) => (
              <a href={link.href} aria-current={current(link.href)}>
                <span lang="zh-Hans">{link.zh}</span>
                <span lang="en">{link.en}</span>
              </a>
            ))
          }
          <a href={site.github} rel="noreferrer">GitHub</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');
  const themeMeta = document.querySelector('meta[name="theme-color"]');

  function preferred(): 'light' | 'dark' {
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function currentTheme(): 'light' | 'dark' {
    const set = root.dataset.theme;
    if (set === 'light' || set === 'dark') return set;
    return preferred();
  }

  function syncTheme() {
    const mode = currentTheme();
    if (themeMeta) themeMeta.setAttribute('content', mode === 'dark' ? '#2a2421' : '#fff6ee');
    if (!button) return;
    const nextLabel = mode === 'dark' ? '切换到浅色' : '切换到深色';
    button.setAttribute('aria-label', nextLabel);
  }

  function syncLang() {
    const mode = root.dataset.lang === 'zh' || root.dataset.lang === 'en' ? root.dataset.lang : 'both';
    root.dataset.lang = mode;
    document.querySelectorAll<HTMLButtonElement>('[data-lang-set]').forEach((item) => {
      item.setAttribute('aria-pressed', item.dataset.langSet === mode ? 'true' : 'false');
    });
  }

  button?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private mode */
    }
    syncTheme();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-lang-set]').forEach((item) => {
    item.addEventListener('click', () => {
      const next = item.dataset.langSet;
      if (next !== 'zh' && next !== 'en' && next !== 'both') return;
      root.dataset.lang = next;
      try {
        localStorage.setItem('beastry-lang', next);
      } catch {
        /* private mode */
      }
      syncLang();
    });
  });

  syncTheme();
  syncLang();
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncTheme);
</script>
