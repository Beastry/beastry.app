---
import type { MarkName } from '../data/site';

interface Props {
  name: MarkName;
  label: string;
}

const { name, label } = Astro.props;
---

<svg viewBox="0 0 64 64" role="img" aria-label={`${label}，占位图形`}>
  <title>{label}</title>
  {
    name === 'octopus' && (
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 31c0-9 5.2-16 12-16s12 7 12 16" />
        <path d="M17 33c-5 2-9 9-6.5 16" />
        <path d="M25 36c-2.5 7-1 14 2.5 18" />
        <path d="M32 38v18" />
        <path d="M39 36c2.5 7 1 14-2.5 18" />
        <path d="M47 33c5 2 9 9 6.5 16" />
        <path d="M25.5 25.5c1 2.2 2.2 2.2 3.2 0" />
        <path d="M35.5 26.2c1 2.2 2.2 2.2 3.2 0" />
        <circle cx="22" cy="44" r="0.8" fill="currentColor" stroke="none" />
        <circle cx="28" cy="48" r="0.8" fill="currentColor" stroke="none" />
        <circle cx="36" cy="48" r="0.8" fill="currentColor" stroke="none" />
        <circle cx="42" cy="44" r="0.8" fill="currentColor" stroke="none" />
      </g>
    )
  }
  {
    name === 'cat' && (
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 28 15 12l12 11" />
        <path d="M42 28 49 12 37 23" />
        <circle cx="32" cy="36" r="14" />
        <circle cx="26.5" cy="35" r="1.15" fill="currentColor" stroke="none" />
        <circle cx="37.5" cy="35" r="1.15" fill="currentColor" stroke="none" />
        <path d="M32 38.2 30.2 41h3.6z" fill="currentColor" stroke="none" />
        <path d="M12 36h8M44 36h8" />
        <path d="M14 41h6M44 41h6" />
      </g>
    )
  }
  {
    name === 'mouse' && (
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="20" cy="20" r="8" />
        <circle cx="36" cy="18" r="7.5" />
        <ellipse cx="30" cy="36" rx="14" ry="13" />
        <circle cx="24.5" cy="35" r="1.15" fill="currentColor" stroke="none" />
        <circle cx="35.5" cy="35" r="1.15" fill="currentColor" stroke="none" />
        <path d="M30 38.5v3" />
        <path d="M38 46c1.5-5 14-5.2 16.2-.4 1.2 3-2.2 6.4-8 6.4s-9.4-3-8.2-6z" />
        <path d="M46.2 43.2v7.2" />
      </g>
    )
  }
  {
    name === 'fox' && (
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 28 9 10l16 12" />
        <path d="M44 28 55 10 39 22" />
        <path d="M16 30c1 16 7 22 16 22s15-6 16-22c-4 5-10 8-16 8s-12-3-16-8z" />
        <circle cx="26" cy="36" r="1.15" fill="currentColor" stroke="none" />
        <circle cx="38" cy="36" r="1.15" fill="currentColor" stroke="none" />
        <path d="M32 39.5v3" />
        <path d="M27 46c1.6 2.4 8.4 2.4 10 0" />
      </g>
    )
  }
  {
    name === 'chameleon' && (
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M24 40c-8 2-12 9-7 13 5 3 8-2 6-6" />
        <ellipse cx="36" cy="38" rx="13" ry="9" />
        <path d="M28 46l-1.5 8M35 47v8M43 46l2 7" />
        <path d="M30 31l1.6-6 1.8 6M37 30l1.6-6 1.8 6" />
        <circle cx="49" cy="33" r="7" />
        <circle cx="51.2" cy="32.2" r="1.7" fill="currentColor" stroke="none" />
        <path d="M55 35h4" />
      </g>
    )
  }
  {
    name === 'bee' && (
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <ellipse cx="32" cy="36" rx="11" ry="15" />
        <path d="M21.5 31h21M21 37h22M21.5 43h21" />
        <ellipse cx="18" cy="28" rx="9" ry="5.5" transform="rotate(-28 18 28)" />
        <ellipse cx="46" cy="28" rx="9" ry="5.5" transform="rotate(28 46 28)" />
        <path d="M28 22c-1-6 .5-9 2-12" />
        <path d="M36 22c1-6-.5-9-2-12" />
        <circle cx="29.2" cy="9.2" r="1.15" fill="currentColor" stroke="none" />
        <circle cx="34.8" cy="9.2" r="1.15" fill="currentColor" stroke="none" />
      </g>
    )
  }
  {
    name === 'squirrel' && (
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M36 50c12-2 20-14 16-26-3-8-12-8-14-1 2 4 2 8 0 11" />
        <path d="M24 54c-10-1-14-12-10-20 3-6 9-8 13-5 7 5 11 12 9 20-1 5-6 8-12 5z" />
        <circle cx="20" cy="24" r="8" />
        <path d="M16 19c.6-6 8-7 9 0" />
        <circle cx="17.2" cy="23.4" r="1.15" fill="currentColor" stroke="none" />
        <path d="M30 46c3.4-.2 6 1.8 6.2 4.4.2 2.6-2.2 4.6-5.2 4.4-2.6-.2-4.6-2.2-4.6-4.6 0-2.2 1.6-4 3.6-4.2z" />
        <path d="M28.2 46c.6-2.6 7.2-2.8 8.2 0" />
      </g>
    )
  }
</svg>
